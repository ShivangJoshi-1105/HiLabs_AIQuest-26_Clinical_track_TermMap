# Hugging Face token with read access to the artifacts repository (and for model downloads)
HF_TOKEN=
# Private Hub repository holding the trained artifacts, e.g. team/termmap-artifacts
TERMMAP_ARTIFACTS_REPO=
# Set to 1 to keep encoders on CPU even when a GPU is present
TERMMAP_FORCE_CPU=0
# Threads used by encoders on CPU
TERMMAP_CPU_THREADS=2
