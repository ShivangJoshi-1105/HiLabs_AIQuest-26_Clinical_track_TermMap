# All variables are optional. The default run needs none of them.

# Hugging Face token: only for higher download rate limits or a private team repository
HF_TOKEN=
# Hub repository to pull model weights from (default: explolearner/termmap-weights)
TERMMAP_ARTIFACTS_REPO=
# Set to 1 to skip the automatic weight download on first run
TERMMAP_NO_DOWNLOAD=0
# Set to 1 to keep encoders on CPU even when a GPU is present
TERMMAP_FORCE_CPU=0
# Threads used by encoders on CPU
TERMMAP_CPU_THREADS=2
